{
    "name": "web-ui",
    "license": "CC-BY-NC-SA-4.0",
    "scripts": {
        "ng": "ng",
        "version": "node ./build/build-pre.js",
        "start": "npm run version && ng serve --proxy-config ../proxy.conf.json",
        "build": "npm run version && node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng build --deploy-url=/static/",
        "test": "npm run version && ng test",
        "lint": "ng lint",
        "i18n": "ng extract-i18n --output-path locale",
        "serve:acc": "npm run version && ng serve --proxy-config ../proxy.acc.conf.json",
        "serve:live": "npm run version && ng serve --proxy-config ../proxy.live.conf.json",
        "serve-docker": "npm run version && ng serve --host 0.0.0.0 --proxy-config ../proxy.docker.json --poll 1000"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^15.2.2",
        "@angular/cdk": "^15.2.2",
        "@angular/common": "^15.2.2",
        "@angular/compiler": "^15.2.2",
        "@angular/core": "^15.2.2",
        "@angular/forms": "^15.2.2",
        "@angular/material": "^15.2.2",
        "@angular/platform-browser": "^15.2.2",
        "@angular/platform-browser-dynamic": "^15.2.2",
        "@angular/router": "^15.2.2",
        "@fortawesome/angular-fontawesome": "^0.12.1",
        "@fortawesome/fontawesome-svg-core": "^6.2.1",
        "@fortawesome/free-solid-svg-icons": "^6.2.1",
        "@ng-select/ng-select": "^10.0.3",
        "ace-builds": "^1.15.1",
        "bezier-easing": "^2.1.0",
        "bulma": "^0.9.4",
        "bulma-badge": "^3.0.1",
        "bulma-pageloader": "^2.2.0",
        "core-js": "^3.25.0",
        "eslint": "^8.33.0",
        "fast-xml-parser": "^3.21.1",
        "file-saver": "^2.0.2",
        "jquery": "^3.6.1",
        "jquery-ui": "^1.13.2",
        "jszip": "^3.10.1",
        "lassy-xpath": "^0.15.1",
        "lodash": "^4.17.15",
        "ngx-clipboard": "^15.1.0",
        "pivottable": "^2.23.0",
        "primeicons": "^6.0.1",
        "primeng": "^15.2.0",
        "rxjs": "^7.8.0",
        "tslib": "^2.4.0",
        "xlsx": "^0.17.5",
        "zone.js": "^0.11.8"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^15.2.2",
        "@angular-eslint/builder": "^15.2.1",
        "@angular-eslint/eslint-plugin": "^15.2.1",
        "@angular-eslint/eslint-plugin-template": "^15.2.1",
        "@angular-eslint/schematics": "^15.2.1",
        "@angular-eslint/template-parser": "^15.2.1",
        "@angular/cli": "^15.2.2",
        "@angular/compiler-cli": "^15.2.2",
        "@angular/localize": "^15.2.2",
        "@types/file-saver": "2.0.1",
        "@types/jasmine": "~3.6.0",
        "@types/jquery": "^3.5.14",
        "@types/jqueryui": "^1.12.16",
        "@types/lodash": "^4.14.184",
        "@typescript-eslint/eslint-plugin": "5.48.2",
        "@typescript-eslint/parser": "5.48.2",
        "array-flat-polyfill": "^1.0.1",
        "jasmine-core": "^3.99.1",
        "karma": "^6.4.0",
        "karma-chrome-launcher": "^3.1.1",
        "karma-coverage": "^2.2.0",
        "karma-jasmine": "^4.0.2",
        "karma-jasmine-html-reporter": "^1.7.0",
        "typescript": "~4.9.4"
    }
}
