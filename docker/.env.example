# Copy to docker/.env before starting the production stack.
# Generate a key with: uv run --no-project --python 3.13 python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# For HTTPS behind a reverse proxy, set its public origin, e.g. https://gretel.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=
REGISTRATION_ENABLED=false
FRONTEND_PORT=80
# Configure SMTP so login, email verification and password reset messages can be sent.
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=webmaster@localhost
# Published images default to ghcr.io/instituutnederlandsetaal/gretel/gretel5-<service>:latest
REGISTRY=ghcr.io/instituutnederlandsetaal/gretel
VERSION=latest
