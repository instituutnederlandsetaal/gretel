FROM eclipse-temurin:21-jre-jammy

RUN apt-get update \
    && apt-get install -y --no-install-recommends wget unzip \
    && rm -rf /var/lib/apt/lists/*
RUN wget -q https://files.basex.org/releases/10.6/BaseX106.zip \
    && unzip -q BaseX106.zip -d / \
    && rm BaseX106.zip \
    && rm -rf /basex/data \
    && ln -s /data /basex/data
WORKDIR /basex

EXPOSE 1984
VOLUME ["/data"]
CMD ["sh", "-c", "bin/basex -c 'PASSWORD admin;EXIT;' && exec bin/basexserver"]
